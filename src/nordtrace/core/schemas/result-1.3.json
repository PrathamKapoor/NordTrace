    "HtmlJsonLdLocator": {
      "additionalProperties": false,
      "description": "A literal source-authored field in one retained UTF8 HTML script.",
      "properties": {
        "kind": {
          "const": "html_json_ld",
          "default": "html_json_ld",
          "title": "Kind",
          "type": "string"
        },
        "representation": {
          "const": "utf8-html-lxml-v1",
          "default": "utf8-html-lxml-v1",
          "title": "Representation",
          "type": "string"
        },
        "script_index": {
          "exclusiveMaximum": 32,
          "minimum": 0,
          "title": "Script Index",
          "type": "integer"
        },
        "pointer": {
          "title": "Pointer",
          "type": "string"
        },
        "raw_value": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Raw Value",
          "type": "string"
        },
        "identity_source_id": {
          "minLength": 1,
          "title": "Identity Source Id",
          "type": "string"
        },
        "normalization": {
          "const": "schema-org-description-v1",
          "default": "schema-org-description-v1",
          "title": "Normalization",
          "type": "string"
        },
        "assertion": {
          "const": "source_authored",
          "default": "source_authored",
          "title": "Assertion",
          "type": "string"
        }
      },
      "required": [
        "script_index",
        "pointer",
        "raw_value",
        "identity_source_id"
      ],
      "title": "HtmlJsonLdLocator",
      "type": "object"
    },
    "JsonNumberLocator": {
      "additionalProperties": false,
      "description": "One exact JSON number token in a retained registry statement (result schema 1.3).",
      "properties": {
        "kind": {
          "const": "json_number",
          "default": "json_number",
          "title": "Kind",
          "type": "string"
        },
        "representation": {
          "const": "json-number-lexeme-v1",
          "default": "json-number-lexeme-v1",
          "title": "Representation",
          "type": "string"
        },
        "pointer": {
          "pattern": "^(/(0|[1-9][0-9]{0,1}))?(/[A-Za-z]+){1,4}$",
          "title": "Pointer",
          "type": "string"
        },
        "raw_value": {
          "maxLength": 256,
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$",
          "title": "Raw Value",
          "type": "string"
        },
        "record_pointer": {
          "pattern": "^(/(0|[1-9][0-9]{0,1}))?$",
          "title": "Record Pointer",
          "type": "string"
        },
        "record_id": {
          "pattern": "^[1-9][0-9]{0,9}$",
          "title": "Record Id",
          "type": "string"
        },
        "normalization": {
          "const": "brreg-account-amount-v1",
          "default": "brreg-account-amount-v1",
          "title": "Normalization",
          "type": "string"
        },
        "multiplier": {
          "const": "1",
          "default": "1",
          "title": "Multiplier",
          "type": "string"
        },
        "unit_basis": {
          "const": "rr0002-denomination-normalized-at-receipt",
          "default": "rr0002-denomination-normalized-at-receipt",
          "title": "Unit Basis",
          "type": "string"
        }
      },
      "required": [
        "pointer",
        "raw_value",
        "record_pointer",
        "record_id"
      ],
      "title": "JsonNumberLocator",
      "type": "object"
    },
    "JsonPointerLocator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "json_pointer",
          "default": "json_pointer",
          "title": "Kind",
          "type": "string"
        },
        "pointer": {
          "title": "Pointer",
          "type": "string"
        },
        "raw_value": {
          "title": "Raw Value"
        },
        "normalization": {
          "default": "identity",
          "enum": [
            "identity",
            "brreg-address-v1",
            "brreg-website-v1",
            "brreg-status-v1",
            "brreg-subunit-v1"
          ],
          "title": "Normalization",
          "type": "string"
        }
      },
      "required": [
        "pointer",
        "raw_value"
      ],
      "title": "JsonPointerLocator",
      "type": "object"
    },

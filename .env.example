# NordTrace configuration. All active names are consumed by Settings.
# Limits below are local defaults, not confirmed organizer budgets.
BRREG_BASE_URL=https://data.brreg.no/enhetsregisteret/api
BRREG_REGNSKAP_URL=https://data.brreg.no/regnskapsregisteret/regnskap
BRREG_TIMEOUT=20
BRREG_BRANCH_PAGE_SIZE=20
BRREG_BRANCH_MAX_PAGES=10
MAX_REQUESTS=2000
MAX_RUNTIME_SEC=2700
MAX_API_COST_USD=10
PER_COMPANY_SOFT_DEADLINE_SEC=90
MAX_PAGES_PER_COMPANY=8
MAX_RESPONSE_BYTES=5242880
MAX_PDF_BYTES=20971520
MAX_REDIRECTS=5
CRAWL_TIMEOUT=15
RESPECT_ROBOTS=true
DATA_DIR=./data
# Optional override; otherwise DATA_DIR/nordtrace.db is used.
# DATABASE_PATH=./data/nordtrace.db
LOG_LEVEL=INFO
USER_AGENT=NordTrace/1.0 (company research; contact via repository)
# Dormant optional client: production extraction/synthesis has no model callers.
# A configured key does not establish integration or authorize charges.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT=30
LLM_MAX_COST_USD=10
LLM_PRICE_INPUT_PER_M=0.15
LLM_PRICE_OUTPUT_PER_M=0.60

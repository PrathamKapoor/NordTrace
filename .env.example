# NordTrace - Norwegian Company Intelligence Agent
# Copy to .env and configure

# Registry / external API
BRREG_API_URL=https://data.brreg.no/enhetsregisteret/api/enheter
BRREG_TIMEOUT=30

# LLM / Extraction
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MAX_COST_USD=10.0
LLM_MAX_TOKENS=4000

# Runtime
MAX_REQUESTS=2000
MAX_RUNTIME_MIN=45
MAX_COMPANIES_BATCH=100

# Caching
CACHE_DIR=./cache
DATABASE_URL=sqlite:///nordtrace.db

# Logging
LOG_LEVEL=INFO

# Security / Web
ALLOWED_DOMAINS=
USER_AGENT=NordTrace/1.0 (research-agent; contact: prathamkapoor027@gmail.com)
